    "name": "CPX",
    "text": "{ ===== CPX 操盘线 · 日线版 ===== }\nTOL:=0.000001;\nMAFA:=0.985;\n\nMA5:=MA(C,5); MA10:=MA(C,10); MA20:=MA(C,20);\nAMT5:=MA(VOL,5); AMT20:=MA(VOL,20);\n\n{ ---- 卖出条件（持股中判定）---- }\nOLD:=DATE<=20070901;\nOLDRISE:=OLD AND MA20>0 AND (C/MA20-1)*100>7;\nR1:=IF(REF(MA10,1)=0,0,(REF(MA5,1)/REF(MA10,1)-1)*100);\nR2:=IF(MA20=0,0,(MA10/MA20-1)*100);\nSELLMA:=OLDRISE AND MA10>=C OR (MAFA*MA5+TOL>C AND MAFA*MA10+TOL>C AND MAFA*MA20+TOL>C);\nSELLRA:=R1>4.3 AND R2>2.8 AND 0.97*MA5>C AND REF(O,2)>C;\nSELLRB:=R1>2.8 AND R2>4.3 AND 0.98*MA10>C;\n\n{ ---- 买入条件（持币中判定）---- }\nNEARCLOSE:=O-TOL<=C AND MA5-TOL<=C;\nBIGUP:=BARSCOUNT(C)>=2 AND 0.9825*H-TOL<=C AND C/REF(C,1)>1.049;\nTRENDUP:=BARSCOUNT(C)>=2 AND UP AND REF(MA5,1)<=MA5;\nENOUGH:=0.9*AMT5-TOL<=VOL AND AMT20<=AMT5;\nCANBUY:=NEARCLOSE AND (BIGUP OR (TRENDUP AND ENOUGH));\n\n{ ===== 递推组：定义顺序 = 每根推进顺序 ===== }\nUP:=IF(BARSCOUNT(C)<=3, 0,\n     IF(BARSCOUNT(C)=4,\n        IF(REF(C,1)+TOL>C, 0, IF(REF(C,1)-TOL<C, 1, IF(REF(C,2)+TOL>REF(C,1), 0, 1))),\n        IF(REF(UP,1),\n           IF(REF(LINE,1)-TOL>C, 0, 1),\n           IF(REF(LINE,1)+TOL>=C, 0, 1))));\nLINE:=IF(BARSCOUNT(C)<=3, 0,\n       IF(BARSCOUNT(C)=4,\n          IF(UP, LLV(LOW,4), HHV(HIGH,4)),\n          IF(REF(UP,1),\n             IF(REF(LINE,1)-TOL>C, HHV(HIGH,4),\n                REF(LINE,1)+REF(STEP,1)*(REF(HIGH,1)-REF(LINE,1))),\n             IF(REF(LINE,1)+TOL>=C,\n                REF(LINE,1)+REF(STEP,1)*(REF(LOW,1)-REF(LINE,1)),\n                LLV(LOW,4)))));\nSTEP:=IF(BARSCOUNT(C)<=3, 0.02,\n       IF(UP<>REF(UP,1), 0.02,\n          IF(REF(STEP,1)<0.2, REF(STEP,1)+0.02, REF(STEP,1))));\n\nHOLD:=IF(REF(HOLD,1),\n         IF((SELLMA AND NOT UP) OR SELLRA OR SELLRB OR (0.96*REF(BUYOPEN,1)>=C), 0, 1),\n         IF(CANBUY AND (NOT OLD OR NOT(REF(COOLDOWN,1) OR REF(COOLDOWN,2) OR REF(COOLDOWN,3))),\n            1, 0));\nBUYOPEN:=IF(HOLD AND NOT REF(HOLD,1), O, REF(BUYOPEN,1));\nCOOLDOWN:=IF(NOT HOLD AND REF(HOLD,1) AND OLDRISE, 1, 0);\n\nCPX:IF(HOLD AND NOT REF(HOLD,1), 2, IF(NOT HOLD AND REF(HOLD,1), -2, IF(HOLD,1,-1)));",
